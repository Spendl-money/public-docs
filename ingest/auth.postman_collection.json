              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('success is true', () => pm.expect(json.success).to.eql(true));",
                  "pm.test('user object present', () => pm.expect(json.user).to.be.an('object'));",
                  "pm.test('kycDetails status is Pending', () => pm.expect(json.user.kycDetails.status).to.eql('Pending'));",
                  "pm.test('userDetails status is pending', () => pm.expect(json.user.userDetails.status).to.eql('pending'));",
                  "pm.test('kycData name matches', () => pm.expect(json.user.kycDetails.kycData.name).to.eql('John'));",
