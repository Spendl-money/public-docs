                  "pm.test('obligation object present', () => pm.expect(json.obligation).to.be.an('object'));",
                  "pm.test('guid is present', () => pm.expect(json.obligation.guid).to.be.a('string'));",
                  "pm.test('processingStatus is present', () => pm.expect(json.obligation.processingStatus).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
